# nginx config for the statically generated site.
# ${BASE_URL} is filled in by the nginx image's envsubst step at container start ("/" by default).

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Relative redirects, so trailing-slash redirects keep working behind a reverse proxy.
    absolute_redirect off;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css text/plain text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Fingerprinted build assets never change.
    location ${BASE_URL}_nuxt/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location = ${BASE_URL}rss.xml {
        default_type application/rss+xml;
        types { }
    }

    # /docs/faq and /docs/faq/ both serve docs/faq/index.html without a redirect.
    location ${BASE_URL} {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        try_files $uri $uri/index.html $uri.html =404;
    }

    error_page 404 ${BASE_URL}404.html;

    # Written at start-up by 40-base-url-redirect.sh: the sub-path redirect, or the old
    # WordPress news URL redirects (legacy-redirects.conf) when served at the root.
    include /etc/nginx/snippets/*.conf;
}
